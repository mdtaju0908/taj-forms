{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/forms/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/forms", "destination": "/index.html" },
    { "source": "/forms/:path*", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/forms/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/forms/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
  ]
}
